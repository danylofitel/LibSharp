<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles every C# code block in README.md against the library.

    The README ships to NuGet as the package readme, so a sample that no longer compiles is a
    public, silent failure: nothing else in the build looks at it. Twice during 5.0.0 an API change
    left the README documenting a constructor or an overload that no longer existed, and only an
    ad-hoc compile caught it. This project turns that into a build error.

    There is no source of its own. The samples are extracted from README.md before compilation, so
    the README stays the single source of truth and cannot drift from what compiles.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- The samples declare only their LibSharp usings, as documentation samples reasonably do.
         Implicit usings supply System, System.Collections.Generic, System.Linq, System.Threading
         and System.Threading.Tasks, which is what a default modern project gives a reader anyway.
         The trade: this verifies the samples call a real API correctly, not that each block is
         copy-paste complete on its own. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>

    <!-- The samples are illustrative: they assign values they never read, and declare locals to
         show a return type. None of that is worth failing a build over. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0219;CS8321;CS0168;CS1998</NoWarn>

    <ReadmePath>$(MSBuildThisFileDirectory)../../README.md</ReadmePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LibSharp/LibSharp.csproj" />
  </ItemGroup>

  <UsingTask TaskName="ExtractReadmeSamples"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ReadmeFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <BlockCount ParameterType="System.Int32" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string markdown = File.ReadAllText(ReadmeFile);

        // Using declarations are hoisted to the top of the generated file; everything else becomes
        // a member of one wrapper class, which is how the samples are written (bare methods).
        SortedSet<string> usings = new SortedSet<string>(StringComparer.Ordinal);
        List<string> bodies = new List<string>();

        foreach (Match block in Regex.Matches(markdown, "```csharp\r?\n(.*?)```", RegexOptions.Singleline))
        {
            StringBuilder body = new StringBuilder();
            foreach (string line in block.Groups[1].Value.Split('\n'))
            {
                string trimmed = line.Trim();
                bool isUsingDirective =
                    trimmed.StartsWith("using ", StringComparison.Ordinal) &&
                    trimmed.EndsWith(";", StringComparison.Ordinal) &&
                    trimmed.IndexOf('=') < 0 &&
                    trimmed.IndexOf('(') < 0;

                if (isUsingDirective)
                {
                    usings.Add(trimmed);
                }
                else
                {
                    body.Append(line.TrimEnd('\r')).Append('\n');
                }
            }

            bodies.Add(body.ToString().Trim('\n'));
        }

        BlockCount = bodies.Count;

        StringBuilder source = new StringBuilder();
        source.AppendLine("// <auto-generated>Extracted from README.md. Do not edit.</auto-generated>");
        foreach (string directive in usings)
        {
            source.AppendLine(directive);
        }

        source.AppendLine();
        source.AppendLine("internal static class ReadmeSamples");
        source.AppendLine("{");
        foreach (string body in bodies)
        {
            source.AppendLine(body);
            source.AppendLine();
        }

        source.AppendLine("}");

        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        File.WriteAllText(OutputFile, source.ToString());
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateReadmeSamples" BeforeTargets="BeforeCompile">
    <!-- IntermediateOutputPath is only defined once the SDK targets have been imported, so the
         path is built here rather than in a top-level PropertyGroup. -->
    <PropertyGroup>
      <GeneratedSamplesPath>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)ReadmeSamples.g.cs</GeneratedSamplesPath>
    </PropertyGroup>

    <ExtractReadmeSamples ReadmeFile="$(ReadmePath)" OutputFile="$(GeneratedSamplesPath)">
      <Output TaskParameter="BlockCount" PropertyName="ReadmeBlockCount" />
    </ExtractReadmeSamples>

    <Error Condition="'$(ReadmeBlockCount)' == '0'"
           Text="No C# code blocks were found in README.md. The extraction is broken, and this project would silently verify nothing." />
    <Message Importance="high" Text="Compiling $(ReadmeBlockCount) README code block(s) against LibSharp." />

    <ItemGroup>
      <Compile Include="$(GeneratedSamplesPath)" />
    </ItemGroup>
  </Target>

</Project>
